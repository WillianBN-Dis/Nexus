<Window x:Class="Nexus.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nexus — Database Studio" Width="1280" Height="880" MinWidth="1040" MinHeight="740" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Icon="Assets/nexus.png" UseLayoutRounding="True" SnapsToDevicePixels="True" SizeChanged="Window_SizeChanged" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
 <Grid x:Name="Root" Margin="22" Background="{StaticResource Bg}">
  <Grid x:Name="LoginView">
   <Viewbox Stretch="Uniform" MaxWidth="1800" MaxHeight="1150" Margin="8">
    <Grid Width="1190" Height="750"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Background="{StaticResource Panel}" CornerRadius="28" Margin="0,0,30,0" Padding="36">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Orientation="Horizontal"><Image Source="Assets/nexus.png" Width="48" Height="48"/><TextBlock Text="nexus" FontSize="30" FontWeight="Bold" Margin="12,0" VerticalAlignment="Center"/></StackPanel>
       <StackPanel Grid.Row="1" VerticalAlignment="Center">
        <Grid Width="290" Height="265" Margin="0,0,0,22"><Ellipse Width="245" Height="245" Stroke="#262B46"/><Ellipse Width="185" Height="185" Stroke="#393353"/><Ellipse Width="120" Height="120" Stroke="#51436E"/><Line X1="55" Y1="198" X2="245" Y2="65" Stroke="#70618C" StrokeThickness="2"/><Ellipse Width="18" Height="18" Fill="#96D8E8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="45,0,0,56"/><Ellipse Width="22" Height="22" Fill="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,54,34,0"/><Border Width="84" Height="84" Background="#302B49" CornerRadius="26"><Image Source="Assets/nexus.png" Width="64" Height="64"/></Border></Grid>
        <TextBlock Text="Tudo conectado.&#10;Tudo no seu controle." FontSize="34" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBlock Text="Um espaço tranquilo para explorar, organizar&#10;e dar vida aos seus dados." FontSize="16" Foreground="{StaticResource Muted}"/>
        <StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Border Background="#24213B" CornerRadius="12" Padding="12,7" Margin="0,0,8,0"><TextBlock Text="SQLite" Foreground="{StaticResource Accent}" FontSize="12"/></Border><Border Background="#24213B" CornerRadius="12" Padding="12,7" Margin="0,0,8,0"><TextBlock Text="Local" Foreground="{StaticResource Accent}" FontSize="12"/></Border><Border Background="#24213B" CornerRadius="12" Padding="12,7"><TextBlock Text="Windows" Foreground="{StaticResource Accent}" FontSize="12"/></Border></StackPanel>
       </StackPanel>
       <TextBlock Grid.Row="2" Text="DATABASE STUDIO   /   0.6.0-wpf.4" Foreground="{StaticResource Muted}" FontSize="11"/>
      </Grid>
     </Border>
     <StackPanel Grid.Column="1" Width="460" VerticalAlignment="Center">
      <TextBlock Text="SEU ESPAÇO DE TRABALHO" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="Bem-vindo ao Nexus" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,10"/>
      <TextBlock Text="Entre com sua conta ou crie uma para começar." FontSize="15" Foreground="{StaticResource Muted}" Margin="0,0,0,28"/>
      <TextBlock Text="Usuário" FontSize="15" Margin="0,0,0,8"/><TextBox x:Name="Username" FontSize="16" AutomationProperties.AutomationId="Username"/>
      <TextBlock Text="Senha" FontSize="15" Margin="0,18,0,8"/><Grid><PasswordBox x:Name="Password" FontSize="16" AutomationProperties.AutomationId="Password"/><TextBox x:Name="VisiblePassword" FontSize="16" Visibility="Collapsed"/></Grid>
      <CheckBox x:Name="ShowPassword" Content="Mostrar senha" FontSize="14" Margin="0,14,0,0" Checked="PasswordVisibility_Changed" Unchecked="PasswordVisibility_Changed"/>
      <TextBlock x:Name="LoginFeedback" Foreground="#FFABBF" FontSize="13" TextWrapping="Wrap" MinHeight="40" Margin="0,14,0,8"/>
      <Button Content="Entrar no Nexus   →" Style="{StaticResource Primary}" FontSize="16" Click="Login_Click" IsDefault="True" Padding="18,14"/>
      <Button Content="Criar conta local" FontSize="15" Click="Register_Click" Margin="0,12,0,22"/>
      <TextBlock Text="Sua conta fica neste computador.&#10;Use pelo menos 10 caracteres na senha." FontSize="13" Foreground="{StaticResource Muted}"/>
     </StackPanel>
    </Grid>
   </Viewbox>
  </Grid>
  <Grid x:Name="WorkspaceView" Visibility="Collapsed" MaxWidth="2400"><Grid.ColumnDefinitions><ColumnDefinition Width="308"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="24" Padding="18" Margin="0,0,20,0"><DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="4,4,0,28"><Image Source="Assets/nexus.png" Width="42" Height="42"/><TextBlock Text="nexus" FontSize="28" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="SEU ESPAÇO" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,0,0,12"/><Button x:Name="CreateDatabaseButton" FontSize="16" Padding="12,11" Content="＋ Novo banco de dados" Click="Create_Click" Style="{StaticResource Primary}" Margin="0,0,0,22"/><TextBlock Text="MEUS BANCOS" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,0,0,10"/><TextBox x:Name="DatabaseSearch" ToolTip="Filtrar bancos pelo nome" TextChanged="DatabaseSearch_Changed" Margin="0,0,0,12" AutomationProperties.Name="Buscar bancos"/></StackPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" CornerRadius="14" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="AccountName" FontWeight="SemiBold"/><TextBlock Text="Conta local · 0.6.0-wpf.4" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,14"/><Button Content="Sair da conta" Click="Logout_Click"/></StackPanel></Border>
    <ListBox x:Name="Databases" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectionChanged="Database_Selected" AutomationProperties.Name="Meus bancos"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="DatabaseHero" Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><DockPanel x:Name="HeroEyebrow"><TextBlock x:Name="HeroBrandLabel" Text="DATABASE STUDIO" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border x:Name="StatusBadge" Background="#1A302D" CornerRadius="10" Padding="10,5" Margin="0,0,8,0"><TextBlock x:Name="Status" Text="Pronto para começar" Foreground="#9EE3C7" FontSize="11" MaxWidth="300" TextTrimming="CharacterEllipsis"/></Border><Border Background="#1A302D" CornerRadius="10" Padding="10,5"><TextBlock Text="● SQLite local" Foreground="#9EE3C7" FontSize="11"/></Border></StackPanel></DockPanel><TextBlock x:Name="DatabaseTitle" Text="Vamos criar algo novo?" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock x:Name="DatabasePath" Text="Selecione um banco ou crie seu primeiro projeto." Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8"><Button x:Name="RenameDatabaseButton" Content="Renomear" Click="Rename_Click" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="MoveDatabaseButton" Content="Mover de Pasta" Click="Move_Click" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="DeleteDatabaseButton" Content="Excluir banco" Style="{StaticResource Danger}" Click="DeleteDatabase_Click" IsEnabled="False" Margin="0,0,8,6"/><Button Content="↻ Atualizar" Click="Refresh_Click" Margin="0,0,0,6"/></WrapPanel>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="2" SelectionChanged="WorkspaceTabs_Changed">
     <TabItem x:Name="VisualTab" Header="Visual"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14"><Button x:Name="NewTableButton" Content="＋ Nova tabela" Style="{StaticResource Primary}" Click="NewTable_Click" DockPanel.Dock="Right" Margin="14,0,0,0" IsEnabled="False"/><StackPanel><TextBlock Text="EXPLORADOR DE DADOS" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Tabelas e registros" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Tables" SelectionChanged="Table_Selected" AutomationProperties.Name="Tabela selecionada"/><TextBlock x:Name="TableSummary" Grid.Column="1" Text="Nenhuma tabela" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/></Grid>
      <TabControl x:Name="VisualTabs" Grid.Row="2" Padding="8" Background="#101522">
       <TabItem Header="Dados"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,12"><Button x:Name="NewRecordButton" Content="＋ Novo registro" Click="NewRecord_Click" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="EditRecordButton" Content="Editar linha" Click="EditRecord_Click" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="DeleteRecordButton" Content="Excluir linha" Click="DeleteRecord_Click" Style="{StaticResource Danger}" IsEnabled="False" Margin="0,0,8,6"/></WrapPanel>
        <Grid Grid.Row="1"><DataGrid x:Name="TableData" SelectionChanged="Record_Selected" Sorting="Table_Sorting" AutoGeneratingColumn="Grid_GeneratingColumn" AutoGeneratedColumns="Grid_GeneratedColumns" MouseDoubleClick="Table_DoubleClick" AutomationProperties.Name="Registros da tabela"/><Border x:Name="EmptyState" Background="#101522"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"><TextBlock Text="◇" Foreground="{StaticResource Accent}" FontSize="38" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="Um espaço para suas ideias" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,8"/><TextBlock x:Name="EmptyHint" Text="Selecione um banco para começar." Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18"/><Button x:Name="EmptyAction" Content="＋ Criar primeira tabela" Style="{StaticResource Primary}" Click="EmptyAction_Click" IsEnabled="False" HorizontalAlignment="Center"/></StackPanel></Border></Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PreviousPage" Content="←" Click="PreviousPage_Click" IsEnabled="False"/><TextBlock x:Name="PageLabel" Text="01" VerticalAlignment="Center" Margin="14,0" Foreground="{StaticResource Accent}"/><Button x:Name="NextPage" Content="→" Click="NextPage_Click" IsEnabled="False"/></StackPanel><TextBlock x:Name="RowsSummary" Text="Selecione uma tabela" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/></DockPanel>
       </Grid></TabItem>
       <TabItem Header="Estrutura"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button x:Name="AddColumnButton" Content="＋ Nova coluna" Click="AddColumn_Click" IsEnabled="False" DockPanel.Dock="Right"/><TextBlock Text="Colunas e tipos de dados" FontSize="18" VerticalAlignment="Center"/></DockPanel><DataGrid x:Name="StructureData" Grid.Row="1" AutoGeneratingColumn="Grid_GeneratingColumn" AutoGeneratedColumns="Grid_GeneratedColumns"/><DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="DropTableButton" Content="Excluir tabela" Style="{StaticResource Danger}" Click="DropTable_Click" DockPanel.Dock="Right" IsEnabled="False"/><TextBlock Text="A exclusão remove a tabela e seus registros." Foreground="#D7A5B7" VerticalAlignment="Center" FontSize="12"/></DockPanel></Grid></TabItem>
      </TabControl>
     </Grid></TabItem>
     <TabItem x:Name="SqlTab" Header="Editor SQL"><Grid><Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="110" MaxHeight="280"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="110"/></Grid.RowDefinitions>
      <TextBox x:Name="Sql" Text="SELECT name, type FROM sqlite_master ORDER BY name;" FontFamily="Consolas" FontSize="15" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
      <Border Grid.Row="1" Background="Transparent" IsHitTestVisible="False"/>
      <DockPanel Grid.Row="2" Margin="0,10,0,14"><Button x:Name="ExecuteButton" VerticalAlignment="Center" MaxHeight="48" Content="▶ Executar SQL" Click="Query_Click" Style="{StaticResource Primary}" IsEnabled="False" DockPanel.Dock="Left" Margin="0,0,14,0"/><TextBlock Text="Ctrl+Enter · Uma instrução · Até 1.000 linhas · Limite de 5 s" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
      <TabControl x:Name="QueryTabs" Grid.Row="3" Padding="8" Background="#101522"><TabItem Header="Tabela"><DataGrid x:Name="QueryData" AutoGeneratingColumn="Grid_GeneratingColumn" AutoGeneratedColumns="Grid_GeneratedColumns"/></TabItem><TabItem Header="Resultado"><TextBox x:Name="QueryText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Execute uma consulta para visualizar o resultado." VerticalContentAlignment="Top"/></TabItem></TabControl>
     </Grid></TabItem>
    </TabControl>

   </Grid>
  </Grid>
  <Border x:Name="BusyInputShield" Background="Transparent" Visibility="Collapsed" Panel.ZIndex="50"/>
  <Border x:Name="BusyStripe" Focusable="True" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#29233E" CornerRadius="14" Padding="18,10" Panel.ZIndex="100"><StackPanel Orientation="Horizontal"><ProgressBar IsIndeterminate="True" Width="70" Height="5" Foreground="{StaticResource Accent}" Background="#453960" VerticalAlignment="Center"/><TextBlock x:Name="BusyText" Text="Trabalhando…" Margin="14,0"/><Button x:Name="CancelQueryButton" Content="Cancelar consulta" Click="CancelQuery_Click" Visibility="Collapsed" Padding="12,6" MinHeight="30"/></StackPanel></Border>
 </Grid>
</Window>
