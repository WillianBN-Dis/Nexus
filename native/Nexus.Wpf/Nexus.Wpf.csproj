<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><AssemblyName>Nexus</AssemblyName><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ApplicationIcon>../../assets/nexus.ico</ApplicationIcon><Version>1.0.0</Version><InformationalVersion>1.0.0</InformationalVersion><StartupObject>Nexus.Wpf.Program</StartupObject></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Nexus.Core/Nexus.Core.csproj" /><Resource Include="../../assets/nexus.png" Link="Assets/nexus.png" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup><Content Include="../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"/></ItemGroup>
</Project>
